# edcx (Django web) production env — independent from the xcmagg scraper.
# Copy to web/.env and fill real values. Loaded by python-decouple (config())
# and injected into the container via infra/docker-compose.yaml (env_file: ../web/.env).
# Do NOT use `export ` prefixes — docker env_file does not parse them.

# Django core
SECRET_KEY=change-me-generate-a-50-char-random-string
# Optional — defaults to racefeed.com.br,www.racefeed.com.br
#ALLOWED_HOSTS=racefeed.com.br,www.racefeed.com.br

# Optional — defaults to https://racefeed.com.br,https://www.racefeed.com.br
#CSRF_TRUSTED_ORIGINS=https://racefeed.com.br,https://www.racefeed.com.br

# Cache — optional. Defaults to the docker-compose memcached service
# (memcached:11211). Override only if memcached lives elsewhere.
#MEMCACHED_LOCATION=memcached:11211

# Cloudflare Turnstile (anti-bot)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Postmark transactional email (optional — defaults to 'missing' if unset)
POSTMARK_SERVER_TOKEN=
