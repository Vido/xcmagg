<!-- Filter Bar -->
<div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
  <div class="flex flex-wrap gap-2">
    <button 
      class="px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-50 transition">
      <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
      </svg>
      Filter
    </button>
  </div>
  
  <span class="text-sm text-gray-600">
    {{ items_qs|length }} items
  </span>
</div>

<!-- Inventory Grid - Photo Gallery Focus -->
<div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
  {% for item in items_qs %}
    {% include "media/_simple_gallery.html" with node=item.node %}
  {% endfor %}
</div>